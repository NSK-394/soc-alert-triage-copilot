# Copy to .env and fill in. See docs/architecture.md §11 for where to get each credential.

# --- Tier 1: Jev (TypeSafe SDK) ---
TYPESAFE_API_KEY=
# Fallback if the Jev waitlist hasn't cleared yet: point the SDK at OpenRouter's
# System One route instead by uncommenting these three lines (a separate
# OPENROUTER_API_KEY credential, not TYPESAFE_API_KEY). Leave JEV_ROUTE unset
# (defaults to "direct" in code) once TYPESAFE_API_KEY starts working.
# JEV_ROUTE=openrouter
# TYPESAFE_BASE_URL=https://openrouter.ai/api/v1/system-one
# OPENROUTER_API_KEY=

# --- Tier 2: OpenAI (Luna / Sol / Astra) ---
OPENAI_API_KEY=
TIER2_MODEL=luna
TIER2_DAILY_BRIEF_CAP=300
TIER2_DAILY_USD_CEILING=10.00

# --- Notifications ---
SLACK_WEBHOOK_URL=
PAGERDUTY_API_KEY=

# --- Postgres ---
# Do not ship with a guessable password -- generate a real one, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(24))"`.
POSTGRES_USER=soc
POSTGRES_PASSWORD=change_me
POSTGRES_DB=soc_triage
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://soc:change_me@postgres:5432/soc_triage

# --- Redis ---
# Same rationale as POSTGRES_PASSWORD above -- an unauthenticated Redis lets
# anyone who can reach it push a raw RQ job payload, which the worker will
# deserialize and execute. Generate a real password before running this stack
# anywhere but strictly local dev.
REDIS_PASSWORD=change_me
REDIS_URL=redis://:change_me@redis:6379/0

# --- Wazuh webhook auth (see services/ingest-api/main.py) ---
# If set, POST /webhook/wazuh requires a matching X-Webhook-Secret header.
# Required before exposing ingest-api past localhost.
WAZUH_WEBHOOK_SECRET=

# --- App ---
INGEST_API_PORT=8000
DASHBOARD_PORT=3000
ENV=development
